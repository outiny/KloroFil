@model List<Site>
@{
    ViewData["Title"] = "Sites ICPE";
}
<div class="entete-page">
    <div>
        <h1 class="titre">Sites et situation ICPE</h1>
        <p class="sous-titre">@Model.Count site(s) · classement dans la nomenclature des installations classées</p>
    </div>
    <div class="actions">
        <a class="btn btn--secondaire" asp-controller="Prescriptions" asp-action="Index">Échéancier des prescriptions</a>
        @if (User.PeutGerer())
        {
            <a class="btn btn--primaire" asp-action="Edition">Ajouter un site</a>
        }
    </div>
</div>

<div class="carte defile">
    @if (Model.Count == 0)
    {
        <p class="vide">Aucun site. Commencez par décrire votre établissement et ses rubriques ICPE.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Site</th><th>Commune</th><th>Régime</th><th>Seveso</th><th>Code AIOT</th><th class="nombre">Rubriques</th><th class="nombre">Prescriptions</th><th class="nombre">En retard</th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var retards = s.Prescriptions.Count(p => p.EnRetard);
                    <tr>
                        <td><a class="reference" asp-action="Details" asp-route-id="@s.Id">@s.Nom</a></td>
                        <td>@s.Commune.Texte()</td>
                        <td><span class="badge badge--@s.Regime.Couleur()">@s.Regime.Libelle()</span></td>
                        <td>@s.Seveso.Libelle()</td>
                        <td>@s.CodeAiot.Texte()</td>
                        <td class="nombre">@s.Classements.Count</td>
                        <td class="nombre">@s.Prescriptions.Count</td>
                        <td class="nombre @(retards > 0 ? "retard-texte" : "")">@retards</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
