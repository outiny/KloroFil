@model List<Exigence>
@{
    ViewData["Title"] = "Registre de conformité";
    Conformite? choix = ViewBag.Conformite;
}
<div class="entete-page">
    <div>
        <h1 class="titre">Registre de conformité réglementaire</h1>
        <p class="sous-titre">Exigences des textes applicables · ISO 14001 § 9.1.2 · @Model.Count exigence(s)</p>
    </div>
    <button class="btn btn--secondaire" onclick="window.print()">Imprimer</button>
</div>

<div class="onglets">
    <a class="@(choix is null ? "is-active" : "")" asp-route-conformite="">Toutes</a>
    @foreach (var c in Enum.GetValues<Conformite>())
    {
        <a class="@(choix == c ? "is-active" : "")" asp-route-conformite="@c">@c.Libelle()</a>
    }
</div>

<div class="carte defile">
    @if (Model.Count == 0)
    {
        <p class="vide">Aucune exigence. Classez des textes « Applicable » puis décomposez-les en exigences.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Texte</th><th>Article</th><th>Exigence</th><th>Conformité</th><th>Évaluée</th><th>Prochaine</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var echue = e.ProchaineEvaluation is { } pe && pe < DateTime.Today;
                    <tr class="@(echue ? "retard" : "")">
                        <td><a class="reference" asp-action="Details" asp-route-id="@e.TexteReglementaireId">@e.Texte?.Titre</a></td>
                        <td>@e.Article.Texte()</td>
                        <td>@e.Description</td>
                        <td><span class="badge badge--@e.Conformite.Couleur()">@e.Conformite.Libelle()</span></td>
                        <td>@e.DateEvaluation.Date()</td>
                        <td class="@(echue ? "retard-texte" : "")">@e.ProchaineEvaluation.Date()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
