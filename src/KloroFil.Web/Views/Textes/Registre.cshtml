@model List<Exigence>
@{
    ViewData["Title"] = "Registre de conformité";
    Conformite? choix = ViewBag.Conformite;
}
<div class="entete-page">
    <div>
        <h1 class="titre">Registre de conformité réglementaire</h1>
        <p class="sous-titre">Exigences des textes applicables · ISO 14001 § 9.1.2 · @Model.Count exigence(s)</p>
    </div>
    <button class="btn btn--secondaire" onclick="window.print()">Imprimer</button>
</div>

<div class="onglets">
    <a class="@(choix is null ? "is-active" : "")" asp-route-conformite="">Toutes</a>
    @foreach (var c in Affichage.Valeurs<Conformite>())
    {
        <a class="@(choix == c ? "is-active" : "")" asp-route-conformite="@c">@c.Libelle()</a>
    }
</div>

<div class="carte defile">
    @if (Model.Count == 0)
    {
        <p class="vide">Aucune exigence. Classez des textes « Applicable » puis décomposez-les en exigences.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Texte</th><th>Article</th><th>Exigence</th><th>Législation</th><th>Récépissé</th><th>Moyens de surveillance</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var derniere = e.Evaluation(PhaseEvaluation.Recepisse) ?? e.Evaluation(PhaseEvaluation.Legislation);
                    <tr>
                        <td><a class="reference titre-texte" asp-action="Details" asp-route-id="@e.TexteReglementaireId">@e.Texte?.Titre</a></td>
                        <td style="white-space:nowrap">@e.Article.Texte()</td>
                        <td class="texte-long">@(e.Description.Length > 400 ? e.Description[..400] + "…" : e.Description)</td>
                        @foreach (var phase in Affichage.Valeurs<PhaseEvaluation>())
                        {
                            var ev = e.Evaluation(phase);
                            <td>
                                @if (ev is null)
                                {
                                    <span class="discret">À faire</span>
                                }
                                else
                                {
                                    <span class="badge badge--@ev.Conformite.Couleur()">@ev.Conformite.Libelle()</span>
                                    <div class="discret">@ev.DateEvaluation.Date()</div>
                                }
                            </td>
                        }
                        <td class="texte-long">@derniere?.MoyensSurveillance.Texte()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
