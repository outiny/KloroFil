@model TexteReglementaire
@{
    ViewData["Title"] = "Texte réglementaire";
    var gerer = User.PeutGerer();
    var saisir = User.PeutSaisir();
    List<ActionQse> actions = ViewBag.Actions;
}
<div class="entete-page">
    <div style="max-width:900px">
        <h1 class="titre">@Model.Titre</h1>
        <p class="sous-titre">
            <span class="badge badge--@Model.Statut.Couleur()">@Model.Statut.Libelle()</span>
            · @Model.Type.Libelle() · @Model.Domaine.Libelle()
            @if (Model.RubriquesConcernees is not null) { <text>· <span class="badge badge--rouge">Rubrique(s) @Model.RubriquesConcernees</span></text> }
        </p>
    </div>
    @if (gerer)
    {
        <div class="actions">
            <a class="btn btn--secondaire" asp-action="Edition" asp-route-id="@Model.Id">Modifier / analyser</a>
            <partial name="_Supprimer" model="@(("Delete", Model.Id, "Supprimer ce texte et ses exigences ?"))" />
        </div>
    }
</div>

@if (gerer && Model.Statut == StatutVeille.AAnalyser)
{
    <div class="alerte alerte--info actions">
        <span>Ce texte n'a pas encore été analysé. Le classer :</span>
        @foreach (var s in new[] { StatutVeille.Applicable, StatutVeille.PourInformation, StatutVeille.NonApplicable })
        {
            <form asp-action="Qualifier" asp-route-id="@Model.Id" asp-route-statut="@s" method="post">
                <button class="btn btn--secondaire btn--petit">@s.Libelle()</button>
            </form>
        }
    </div>
}

<div class="carte">
    <h2 class="carte__titre">Fiche du texte</h2>
    <dl class="fiche">
        <div><dt>Référence</dt><dd>@Model.Reference.Texte()</dd></div>
        <div><dt>Publication</dt><dd>@Model.DatePublication.Date()</dd></div>
        <div><dt>Application</dt><dd>@Model.DateApplication.Date()</dd></div>
        <div><dt>Détecté le</dt><dd>@Model.DateDetection.Date() @(Model.SourceVeille is null ? "(saisie manuelle)" : "via " + Model.SourceVeille.Nom)</dd></div>
        <div><dt>Analysé</dt><dd>@(Model.AnalyseLe is null ? "–" : Model.AnalyseLe.Date() + " par " + Model.AnalysePar.Texte())</dd></div>
        @if (!string.IsNullOrWhiteSpace(Model.Url))
        {
            <div><dt>Lien</dt><dd><a href="@Model.Url" target="_blank" rel="noopener noreferrer">Consulter le texte ↗</a></dd></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Resume))
        {
            <div class="large"><dt>Résumé</dt><dd class="texte-long">@Model.Resume</dd></div>
        }
        <div class="large"><dt>Analyse / impact pour l'entreprise</dt><dd class="texte-long">@Model.Analyse.Texte()</dd></div>
    </dl>
</div>

@if (Model.Exigences.Count > 0)
{
    <div class="carte">
        <h2 class="carte__titre">Avancement des évaluations</h2>
        <partial name="_Avancement" model="@Avancement.Calculer(Model.Exigences)" />
    </div>
}

<div class="carte defile">
    <h2 class="carte__titre">
        Exigences applicables et évaluation de conformité (@Model.Exigences.Count)
        @if (gerer)
        {
            <span class="actions">
                @if (KloroFil.Web.Services.LegifranceClient.IdentifiantTexte(Model.Url) is not null)
                {
                    <form asp-action="ImporterArticles" asp-route-id="@Model.Id" method="post"
                          title="Lit la version en vigueur sur Légifrance : un point par article et par paragraphe numéroté des annexes. Réimporter met à jour les points modifiés.">
                        <button class="btn btn--primaire btn--petit">@(Model.Exigences.Count == 0 ? "Importer les articles et annexes" : "Mettre à jour depuis Légifrance")</button>
                    </form>
                }
                <a asp-action="Exigence" asp-route-texteId="@Model.Id">+ Ajouter une exigence</a>
            </span>
        }
    </h2>
    @if (Model.Exigences.Count == 0)
    {
        <p class="vide">Aucune exigence. Pour un texte applicable, importez ses articles et annexes depuis Légifrance, ou décomposez-le en exigences à évaluer périodiquement.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Article</th><th>Exigence</th><th>Législation</th><th>Récépissé</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model.Exigences)
                {
                    <tr>
                        <td style="white-space:nowrap">@e.Article.Texte()</td>
                        <td>
                            @{
                                var lignes = e.Description.Split('\n', 2);
                                var titre = lignes.Length > 1 && lignes[0].Length <= 200 ? lignes[0] : null;
                                var corps = titre is null ? e.Description : lignes[1];
                            }
                            @if (titre is not null) { <strong>@titre</strong> }
                            @if (corps.Length <= 300)
                            {
                                <div class="texte-long">@corps</div>
                            }
                            else
                            {
                                <details>
                                    <summary class="texte-long">@corps[..280]… <span class="discret">(lire la suite)</span></summary>
                                    <div class="texte-long">@corps</div>
                                </details>
                            }
                        </td>
                        @foreach (var phase in Affichage.Valeurs<PhaseEvaluation>())
                        {
                            var ev = e.Evaluation(phase);
                            <td style="min-width:150px">
                                @if (ev is null)
                                {
                                    <span class="discret">À faire</span>
                                }
                                else
                                {
                                    <span class="badge badge--@ev.Conformite.Couleur()">@ev.Conformite.Libelle()</span>
                                    <div class="discret">@ev.DateEvaluation.Date() @ev.EvaluePar</div>
                                }
                                @if (saisir)
                                {
                                    <div><a class="discret" asp-action="Exigence" asp-route-id="@e.Id" asp-route-texteId="@Model.Id" asp-route-phase="@phase">@(ev is null ? "Évaluer" : "Modifier")</a></div>
                                }
                            </td>
                        }
                        <td>
                            <div class="actions">
                                @if (saisir)
                                {
                                    @if (e.Conformite is Conformite.NonConforme or Conformite.NcEnCours)
                                    {
                                        <a class="btn btn--secondaire btn--petit" asp-controller="Actions" asp-action="Edition" asp-route-exigenceId="@e.Id">+ Action</a>
                                    }
                                }
                                @if (gerer)
                                {
                                    <form asp-action="SupprimerExigence" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Supprimer cette exigence ?')">
                                        <button class="btn btn--danger btn--petit">Supprimer</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="carte defile">
    <h2 class="carte__titre">
        Actions liées
        @if (saisir)
        {
            <a asp-controller="Actions" asp-action="Edition" asp-route-texteId="@Model.Id">+ Créer une action</a>
        }
    </h2>
    @if (actions.Count == 0)
    {
        <p class="vide">Aucune action liée à ce texte.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>N°</th><th>Action</th><th>Responsable</th><th>Échéance</th><th>Statut</th></tr></thead>
            <tbody>
                @foreach (var a in actions)
                {
                    <tr class="@(a.EnRetard ? "retard" : "")">
                        <td><a class="reference" asp-controller="Actions" asp-action="Edition" asp-route-id="@a.Id">@a.Numero</a></td>
                        <td>@a.Titre</td>
                        <td>@a.Responsable.Texte()</td>
                        <td class="@(a.EnRetard ? "retard-texte" : "")">@a.Echeance.Date()</td>
                        <td><span class="badge badge--@a.Statut.Couleur()">@a.Statut.Libelle()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
