@model List<TexteReglementaire>
@{
    ViewData["Title"] = "Veille réglementaire";
    StatutVeille? statut = ViewBag.Statut;
    Domaine? domaine = ViewBag.Domaine;
    Dictionary<StatutVeille, int> compteurs = ViewBag.Compteurs;
    int N(StatutVeille s) => compteurs.GetValueOrDefault(s);
    var gerer = User.PeutGerer();
    var retour = Context.Request.Path + Context.Request.QueryString;
    Dictionary<int, Avancement> avancements = ViewBag.Avancements;
    Avancement global = ViewBag.AvancementApplicables;
}
<div class="entete-page">
    <div>
        <h1 class="titre">Veille réglementaire</h1>
        <p class="sous-titre">Registre des textes environnementaux et ICPE · @compteurs.Values.Sum() texte(s)</p>
    </div>
    <div class="actions">
        <a class="btn btn--secondaire" asp-action="Registre">Registre de conformité</a>
        @if (gerer)
        {
            <form asp-action="LancerVeille" method="post"><button class="btn btn--secondaire">Lancer la veille</button></form>
            <a class="btn btn--primaire" asp-action="Edition">Ajouter un texte</a>
        }
    </div>
</div>

@if (global.Total > 0 && statut is null or StatutVeille.Applicable)
{
    <div class="carte">
        <h2 class="carte__titre">Avancement des évaluations – textes applicables</h2>
        <partial name="_Avancement" model="@global" />
    </div>
}

<div class="onglets">
    <a class="@(statut is null ? "is-active" : "")" asp-route-statut="@TextesController.TousLesStatuts" asp-route-domaine="@domaine">Tous</a>
    @foreach (var s in Enum.GetValues<StatutVeille>())
    {
        <a class="@(statut == s ? "is-active" : "")" asp-route-statut="@s" asp-route-domaine="@domaine">@s.Libelle() (@N(s))</a>
    }
</div>
<form method="get" class="filtres">
    <input type="hidden" name="statut" value="@(statut?.ToString() ?? TextesController.TousLesStatuts)" />
    <select name="domaine" asp-items="Affichage.Choix(domaine)" onchange="this.form.submit()"><option value="">Tous les domaines</option></select>
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Titre, NOR, rubrique…" />
    <button class="btn btn--secondaire">Filtrer</button>
</form>
@if (gerer)
{
    <form asp-action="ImporterNor" method="post" class="filtres">
        <input name="nor" placeholder="NOR (ex. ATEP9760302A)" maxlength="20" autocomplete="off" />
        <button class="btn btn--secondaire" title="Ajoute un texte du Journal officiel, même ancien, à partir de son NOR">Importer de Légifrance</button>
    </form>
}

<div class="carte defile">
    @if (Model.Count == 0)
    {
        string? q = ViewBag.Q;
        var ressembleNor = q is { Length: >= 8 and <= 20 } && q.Trim().All(char.IsLetterOrDigit) && q.Trim().Any(char.IsDigit) && q.Trim().Any(char.IsLetter);
        <div class="vide">
            Aucun texte @(statut is null ? "" : "« " + statut.Value.Libelle() + " » ")pour ces critères.
            @if (statut is not null)
            {
                <a asp-route-statut="@TextesController.TousLesStatuts" asp-route-domaine="@domaine" asp-route-q="@ViewBag.Q">Chercher dans tous les textes</a>
            }
            @if (gerer && ressembleNor)
            {
                <form asp-action="ImporterNor" method="post" class="actions" style="margin-top:10px">
                    <input type="hidden" name="nor" value="@q!.Trim()" />
                    <span>La veille ne parcourt que les 12 derniers mois. Ce texte est peut-être plus ancien :</span>
                    <button class="btn btn--primaire btn--petit">Importer @q!.Trim().ToUpperInvariant() depuis Légifrance</button>
                </form>
            }
        </div>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Publication</th><th>Texte</th><th>Type</th><th>Domaine</th><th>Rubriques</th><th>Avancement des évaluations</th><th>Statut</th>@if (gerer) { <th>Qualifier</th> }</tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@((t.DatePublication ?? t.DateDetection).Date())</td>
                        <td>
                            <a class="reference titre-texte" asp-action="Details" asp-route-id="@t.Id">@t.Titre</a>
                            @if (t.Reference is not null) { <div class="discret">@t.Reference</div> }
                        </td>
                        <td>@t.Type.Libelle()</td>
                        <td>@t.Domaine.Libelle()</td>
                        <td>@if (t.RubriquesConcernees is not null) { <span class="badge badge--rouge">@t.RubriquesConcernees</span> }</td>
                        <td>
                            <partial name="_AvancementCompact" model="@avancements.GetValueOrDefault(t.Id)" />
                            @if (t.Exigences.Count > 0) { <div class="discret">@t.Exigences.Count exigence(s)</div> }
                        </td>
                        <td><span class="badge badge--@t.Statut.Couleur()">@t.Statut.Libelle()</span></td>
                        @if (gerer)
                        {
                            <td>
                                @if (t.Statut == StatutVeille.AAnalyser)
                                {
                                    <div class="actions">
                                        @foreach (var (s, l) in new[] { (StatutVeille.Applicable, "Applicable"), (StatutVeille.PourInformation, "Info"), (StatutVeille.NonApplicable, "Non app.") })
                                        {
                                            <form asp-action="Qualifier" asp-route-id="@t.Id" asp-route-statut="@s" asp-route-retour="@retour" method="post">
                                                <button class="btn btn--secondaire btn--petit">@l</button>
                                            </form>
                                        }
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
