@model ExigenceVm
@{
    var nouvelle = Model.Exigence.Id == 0;
    ViewData["Title"] = nouvelle ? "Nouvelle exigence" : $"{Model.Phase.Libelle()} – {Model.Exigence.Article}";
    var gerer = User.PeutGerer();
    var texteId = Model.Exigence.TexteReglementaireId;
    // Ancre de la ligne de l'exigence dans la fiche du texte (ou du tableau pour une nouvelle exigence).
    var ancre = nouvelle ? "exigences" : $"exigence-{Model.Exigence.Id}";

    // Texte replié par défaut : on n'affiche que son intitulé (1re ligne courte) ou son début.
    static string TitreExigence(string texte)
    {
        var premiere = texte.Split('\n', 2)[0].Trim();
        return premiere.Length <= 120 ? premiere : premiere[..117] + "…";
    }

    // Contenu affiché une fois ouvert : sans l'intitulé s'il est déjà entier dans la barre.
    static string CorpsExigence(string texte)
    {
        var parties = texte.Split('\n', 2);
        return parties.Length == 2 && parties[0].Trim().Length <= 120 ? parties[1] : texte;
    }
}
<div class="entete-page">
    <div class="entete-texte">
        <h1 class="titre">@(nouvelle ? "Nouvelle exigence" : "Évaluation de conformité" + (Model.Exigence.Article is null ? "" : " – " + Model.Exigence.Article))</h1>
        <p class="sous-titre">@Model.TitreTexte</p>
    </div>
    <a class="btn btn--secondaire" asp-action="Details" asp-route-id="@texteId" asp-fragment="@ancre">Retour au texte</a>
</div>

@if (!nouvelle)
{
    @* Une fenêtre par phase : « Législation » quand le texte devient applicable, « Récépissé » une fois le dossier déposé. *@
    <div class="onglets">
        @foreach (var p in Affichage.Valeurs<PhaseEvaluation>())
        {
            var ev = Model.Evaluations.FirstOrDefault(v => v.Phase == p);
            <a class="@(p == Model.Phase ? "is-active" : "")" asp-action="Exigence" asp-route-id="@Model.Exigence.Id" asp-route-texteId="@texteId" asp-route-phase="@p">
                @p.Libelle() @(ev is null ? "(à faire)" : "– " + ev.Conformite.Libelle())
            </a>
        }
    </div>
}

<form method="post" asp-action="Exigence" asp-route-id="@(nouvelle ? null : Model.Exigence.Id)" class="carte">
    <h2 class="carte__titre">@Model.Phase.Libelle()</h2>
    <input type="hidden" asp-for="Exigence.TexteReglementaireId" />
    <input type="hidden" asp-for="Phase" />
    <div class="formulaire">
        <div asp-validation-summary="ModelOnly" class="champ--large"></div>
        <div class="champ--large legende-sources" style="padding:0">
            <span><span class="etiquette-source etiquette-source--importe" style="margin:0">Importé de Légifrance</span> texte officiel</span>
            <span><span class="etiquette-source etiquette-source--saisie" style="margin:0">Saisi dans KloroFil</span> vos commentaires et évaluations</span>
        </div>
        @if (Model.Exigence.Importee)
        {
            @* Texte officiel : affiché tel quel ; un gestionnaire peut encore le réécrire (il devient alors une saisie). *@
            <div class="champ champ--large">
                <label>Exigence @Model.Exigence.Article <span class="etiquette-source etiquette-source--importe">Importé de Légifrance</span></label>
                <details class="texte-repliable bloc-importe">
                    <summary><strong>@TitreExigence(Model.Exigence.Description)</strong> <span class="discret">– afficher le texte</span></summary>
                    <div class="texte-long">@CorpsExigence(Model.Exigence.Description)</div>
                </details>
                @if (gerer)
                {
                    <details style="margin-top:6px">
                        <summary class="discret">Modifier le libellé (il sera alors considéré comme une saisie)</summary>
                        <div class="formulaire" style="padding:8px 0 0">
                            <div class="champ"><label asp-for="Exigence.Article"></label><input asp-for="Exigence.Article" /></div>
                            <div class="champ champ--large"><label asp-for="Exigence.Description"></label><textarea asp-for="Exigence.Description" rows="5"></textarea><span asp-validation-for="Exigence.Description"></span></div>
                        </div>
                    </details>
                }
            </div>
        }
        else if (gerer)
        {
            <div class="champ champ--saisie"><label asp-for="Exigence.Article"></label><input asp-for="Exigence.Article" /></div>
            <div class="champ champ--large champ--saisie">
                <label asp-for="Exigence.Description"><span class="etiquette-source etiquette-source--saisie">Saisi dans KloroFil</span></label>
                <textarea asp-for="Exigence.Description" rows="5"></textarea><span asp-validation-for="Exigence.Description"></span>
            </div>
        }
        else
        {
            <div class="champ champ--large"><label>Exigence @Model.Exigence.Article <span class="etiquette-source etiquette-source--saisie">Saisi dans KloroFil</span></label><details class="texte-repliable bloc-saisie"><summary><strong>@TitreExigence(Model.Exigence.Description)</strong> <span class="discret">– afficher le texte</span></summary><div class="texte-long">@CorpsExigence(Model.Exigence.Description)</div></details></div>
        }

        <p class="separateur">Évaluation – @Model.Phase.Libelle() <span class="etiquette-source etiquette-source--saisie">Saisi dans KloroFil</span></p>
        <div class="champ champ--saisie"><label asp-for="Evaluation.Conformite"></label><select asp-for="Evaluation.Conformite" asp-items="Affichage.Choix(Model.Evaluation.Conformite)"></select></div>
        <div class="champ champ--saisie"><label asp-for="Evaluation.DateEvaluation"></label><input asp-for="Evaluation.DateEvaluation" type="date" /></div>
        <div class="champ champ--saisie"><label asp-for="Evaluation.EvaluePar"></label><input asp-for="Evaluation.EvaluePar" list="responsables" /></div>
        <div class="champ champ--large champ--saisie"><label asp-for="Evaluation.CriteresEvaluation"></label><textarea asp-for="Evaluation.CriteresEvaluation" rows="3" placeholder="Ce qui permet de dire que l'exigence est respectée : valeur limite, document attendu, fréquence…"></textarea></div>
        <div class="champ champ--large champ--saisie"><label asp-for="Evaluation.MoyensSurveillance"></label><textarea asp-for="Evaluation.MoyensSurveillance" rows="3" placeholder="Contrôle périodique, mesure, registre, inspection interne, indicateur…"></textarea></div>
        <div class="champ champ--large champ--saisie"><label asp-for="Evaluation.ActionsCorrectives"></label><textarea asp-for="Evaluation.ActionsCorrectives" rows="3" placeholder="Actions décidées en cas d'écart (à reporter aussi dans le plan d'actions avec « + Action »)."></textarea></div>
        <div class="champ champ--large champ--saisie"><label asp-for="Evaluation.Preuves"></label><textarea asp-for="Evaluation.Preuves" rows="3" placeholder="Rapport de contrôle, enregistrement, constat, n° et date du récépissé…"></textarea></div>

        <div class="actions champ--large">
            <button class="btn btn--primaire">Enregistrer</button>
            <a class="btn btn--secondaire" asp-action="Details" asp-route-id="@texteId" asp-fragment="@ancre">Annuler</a>
            @if (!nouvelle && User.PeutSaisir() && Model.Evaluation.Conformite is Conformite.NonConforme or Conformite.NcEnCours)
            {
                <a class="btn btn--secondaire" asp-controller="Actions" asp-action="Edition" asp-route-exigenceId="@Model.Exigence.Id">+ Action dans le plan d'actions</a>
            }
        </div>
    </div>
</form>
<partial name="_Responsables" />
