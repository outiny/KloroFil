@model Audit
@{
    ViewData["Title"] = Model.Type.Libelle();
    List<ActionQse> actions = ViewBag.Actions;
}
<div class="entete-page">
    <div>
        <h1 class="titre">@Model.Type.Libelle() du @Model.Date.Date()</h1>
        <p class="sous-titre">@(Model.Site?.Nom ?? "Tous les sites") · @Model.Auditeur.Texte()</p>
    </div>
    @if (User.PeutGerer())
    {
        <div class="actions">
            <a class="btn btn--secondaire" asp-action="Edition" asp-route-id="@Model.Id">Modifier</a>
            <partial name="_Supprimer" model="@(("Delete", Model.Id, "Supprimer cet audit ?"))" />
        </div>
    }
</div>

<div class="grille-kpi">
    <div class="kpi @(Model.NcMajeures > 0 ? "kpi--alerte" : "")"><div class="kpi__libelle">Non-conformités majeures</div><div class="kpi__valeur">@Model.NcMajeures</div></div>
    <div class="kpi @(Model.NcMineures > 0 ? "kpi--attention" : "")"><div class="kpi__libelle">Non-conformités mineures</div><div class="kpi__valeur">@Model.NcMineures</div></div>
    <div class="kpi"><div class="kpi__libelle">Observations</div><div class="kpi__valeur">@Model.Observations</div></div>
    <div class="kpi"><div class="kpi__libelle">Actions ouvertes</div><div class="kpi__valeur">@actions.Count(a => a.Ouverte)</div></div>
</div>

<div class="carte">
    <h2 class="carte__titre">Compte rendu</h2>
    <dl class="fiche">
        <div><dt>Périmètre</dt><dd>@Model.Perimetre.Texte()</dd></div>
        @if (!string.IsNullOrWhiteSpace(Model.Rapport))
        {
            <div><dt>Rapport</dt><dd>
                @if (Uri.TryCreate(Model.Rapport, UriKind.Absolute, out var u) && (u.Scheme == "http" || u.Scheme == "https"))
                {
                    <a href="@Model.Rapport" target="_blank" rel="noopener noreferrer">Ouvrir le rapport ↗</a>
                }
                else
                {
                    @Model.Rapport
                }
            </dd></div>
        }
        <div class="large"><dt>Conclusion</dt><dd class="texte-long">@Model.Conclusion.Texte()</dd></div>
    </dl>
</div>

<div class="carte defile">
    <h2 class="carte__titre">
        Actions issues de l'audit
        @if (User.PeutSaisir())
        {
            <a asp-controller="Actions" asp-action="Edition" asp-route-auditId="@Model.Id">+ Créer une action</a>
        }
    </h2>
    @if (actions.Count == 0)
    {
        <p class="vide">Aucune action.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>N°</th><th>Action</th><th>Responsable</th><th>Échéance</th><th>Statut</th></tr></thead>
            <tbody>
                @foreach (var a in actions)
                {
                    <tr class="@(a.EnRetard ? "retard" : "")">
                        <td><a class="reference" asp-controller="Actions" asp-action="Edition" asp-route-id="@a.Id">@a.Numero</a></td>
                        <td>@a.Titre</td>
                        <td>@a.Responsable.Texte()</td>
                        <td class="@(a.EnRetard ? "retard-texte" : "")">@a.Echeance.Date()</td>
                        <td><span class="badge badge--@a.Statut.Couleur()">@a.Statut.Libelle()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
