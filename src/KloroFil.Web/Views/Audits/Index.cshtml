@model List<Audit>
@{
    ViewData["Title"] = "Audits et inspections";
}
<div class="entete-page">
    <div>
        <h1 class="titre">Audits, inspections et revues</h1>
        <p class="sous-titre">ISO 14001 § 9.2 et 9.3 · inspections des installations classées · @Model.Count enregistrement(s)</p>
    </div>
    @if (User.PeutGerer())
    {
        <a class="btn btn--primaire" asp-action="Edition">Ajouter un audit</a>
    }
</div>

<div class="carte defile">
    @if (Model.Count == 0)
    {
        <p class="vide">Aucun audit enregistré.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Date</th><th>Type</th><th>Site</th><th>Auditeur</th><th>Périmètre</th><th class="nombre">NC maj.</th><th class="nombre">NC min.</th><th class="nombre">Obs.</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><a class="reference" asp-action="Details" asp-route-id="@a.Id">@a.Date.Date()</a></td>
                        <td>@a.Type.Libelle()</td>
                        <td>@(a.Site?.Nom ?? "Tous")</td>
                        <td>@a.Auditeur.Texte()</td>
                        <td>@a.Perimetre.Texte()</td>
                        <td class="nombre @(a.NcMajeures > 0 ? "retard-texte" : "")">@a.NcMajeures</td>
                        <td class="nombre">@a.NcMineures</td>
                        <td class="nombre">@a.Observations</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
