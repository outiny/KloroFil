@model List<ActionQse>
@{
    ViewData["Title"] = "Plan d'actions";
    string filtre = ViewBag.Filtre;
    OrigineAction? origine = ViewBag.Origine;
    string Onglet(string f) => filtre == f ? "is-active" : "";
}
<div class="entete-page">
    <div>
        <h1 class="titre">Plan d'actions environnemental</h1>
        <p class="sous-titre">Actions correctives, préventives et de mise en conformité · @Model.Count action(s)</p>
    </div>
    @if (User.PeutSaisir())
    {
        <a class="btn btn--primaire" asp-action="Edition">Nouvelle action</a>
    }
</div>

<div class="onglets">
    <a class="@Onglet("ouvertes")" asp-route-filtre="ouvertes" asp-route-origine="@origine">Ouvertes</a>
    <a class="@Onglet("retard")" asp-route-filtre="retard" asp-route-origine="@origine">En retard</a>
    <a class="@Onglet("verifier")" asp-route-filtre="verifier" asp-route-origine="@origine">Efficacité à vérifier</a>
    <a class="@Onglet("closes")" asp-route-filtre="closes" asp-route-origine="@origine">Closes</a>
    <a class="@Onglet("toutes")" asp-route-filtre="toutes" asp-route-origine="@origine">Toutes</a>
</div>
<form method="get" class="filtres">
    <input type="hidden" name="filtre" value="@filtre" />
    <select name="origine" asp-items="Affichage.Choix(origine)" onchange="this.form.submit()"><option value="">Toutes les origines</option></select>
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Action, responsable…" />
    <button class="btn btn--secondaire">Filtrer</button>
</form>

<div class="carte defile">
    @if (Model.Count == 0)
    {
        <p class="vide">Aucune action pour ces critères.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>N°</th><th>Action</th><th>Type</th><th>Origine</th><th>Priorité</th><th>Responsable</th><th>Échéance</th><th>Statut</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr class="@(a.EnRetard ? "retard" : "")">
                        <td><a class="reference" asp-action="Edition" asp-route-id="@a.Id">@a.Numero</a></td>
                        <td>@a.Titre</td>
                        <td>@a.Type.Libelle()</td>
                        <td>@a.Origine.Libelle()</td>
                        <td><span class="badge badge--@a.Priorite.Couleur()">@a.Priorite.Libelle()</span></td>
                        <td>@a.Responsable.Texte()</td>
                        <td class="@(a.EnRetard ? "retard-texte" : "")">@a.Echeance.Date()</td>
                        <td><span class="badge badge--@a.Statut.Couleur()">@a.Statut.Libelle()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
