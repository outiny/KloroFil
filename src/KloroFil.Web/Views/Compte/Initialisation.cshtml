@model NouvelUtilisateurVm
@{
    ViewData["Title"] = "Premier démarrage";
    Layout = "_LayoutConnexion";
}
<h1>Premier démarrage</h1>
<p class="sous-titre">Créez le compte administrateur de KloroFil.</p>
<form method="post" asp-action="Initialisation">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="champ"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="username" autofocus /><span asp-validation-for="Email"></span></div>
    <div class="champ"><label asp-for="NomComplet"></label><input asp-for="NomComplet" autocomplete="name" /></div>
    <div class="champ"><label asp-for="Fonction"></label><input asp-for="Fonction" placeholder="Responsable QSE" /></div>
    <div class="champ"><label asp-for="MotDePasse"></label><input asp-for="MotDePasse" autocomplete="new-password" /><span asp-validation-for="MotDePasse"></span></div>
    <div class="champ"><label asp-for="Confirmation"></label><input asp-for="Confirmation" autocomplete="new-password" /><span asp-validation-for="Confirmation"></span></div>
    <p class="aide">10 caractères minimum.</p>
    <button class="btn btn--primaire">Créer le compte administrateur</button>
</form>
